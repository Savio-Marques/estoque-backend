# Configurações do Banco de Dados PostgreSQL
POSTGRES_USER=root
POSTGRES_PASSWORD=sua_senha_secreta_aqui
POSTGRES_DB=estoque_db

# Configurações de Segurança (JWT - mínimo 32 caracteres)
JWT_SECRET=sua_chave_secreta_jwt_para_producao_aqui

# Configurações de CORS e Documentação
CORS_ALLOWED_ORIGINS=https://buscapestoque.vercel.app
SWAGGER_ENABLED=false

# Conta Root (ADMIN) inicializada automaticamente (opcional)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
